{
  "drawio": {
    "command": "npx",
    "args": ["-y", "@drawio/mcp"]
  },
  "github": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "__GH_TOKEN__"
    }
  },
  "notion-personal": {
    "command": "npx",
    "args": ["-y", "@notionhq/notion-mcp-server"],
    "env": {
      "NOTION_TOKEN": "__NOTION_PERSONAL_TOKEN__"
    }
  },
  "notion-work": {
    "command": "npx",
    "args": ["-y", "@notionhq/notion-mcp-server"],
    "env": {
      "NOTION_TOKEN": "__NOTION_WORK_TOKEN__"
    }
  }
}

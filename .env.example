# Copy fragments of this into ~/.claude/.env and ~/.hermes/.env as appropriate.
# DO NOT put real secrets in this file. This is committed; the real .env files are not.

# ---- Claude Code (~/.claude/.env) ----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Hermes (~/.hermes/.env) ----
# OPENROUTER_API_KEY=...
# OPENAI_API_KEY=...
# NOUS_PORTAL_API_KEY=...

# ---- Shared: GitHub access for agents ----
# Fine-grained PAT recommended, scoped to repos the agents may touch.
# Permissions: Contents R/W, Pull requests R/W, Issues R/W, Metadata R.
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...
